# MLflow workshop environment (loaded by mlflow_3_demo.ipynb via python-dotenv)
# Copy this file and replace placeholder values before running the workshop.

# --- MLflow server ---
MLFLOW_TRACKING_URI=http://localhost:5000

# Active workspace (requires server started with --enable-workspaces).
# Use "default" for the reserved default workspace, or switch to e.g. "team-a" later.
MLFLOW_WORKSPACE=default

# --- AI Gateway ---
# Endpoint name as configured in the MLflow UI / gateway config.yaml (not the provider model id).
MLFLOW_GATEWAY_ENDPOINT=my-ai-gateway-endpoint

# --- Workshop resources (scoped to the active workspace when workspaces are enabled) ---
MLFLOW_EXPERIMENT_NAME=mlflow-3-genai-workshop
MLFLOW_PROMPT_NAME=workshop-dummy-prompt

# Set to false to skip prompt optimization (~30s, extra LLM calls)
RUN_OPTIMIZATION=true

# --- Provider credentials (for the MLflow AI Gateway / Docker container) ---
# The notebook does not need this key when calling through the gateway.
OPENAI_API_KEY=sk-replace-me
